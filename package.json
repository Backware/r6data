{
  "name": "r6data",
  "version": "0.0.0-alpha.9",
  "author": "Daniel Werg",
  "description": "Operators, weapons, seasons, maps, gadgets and attachments data for Rainbow Six Siege",
  "license": "MIT",
  "repository": "danielwerg/r6data",
  "exports": {
    "types": "./dist/index.d.ts",
    "require": "./dist/index.js",
    "import": "./dist/index.mjs"
  },
  "module": "dist/index.mjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prebuild": "rimraf dist && npm run lint-tsc && npm run lint && npm run spell && npm run svg2png",
    "build": "vite build",
    "build:prepare": "path-exists ./dist || npm run build",
    "prepublishOnly": "npm run build",
    "svg2png": "tsx scripts/svg2png.ts",
    "preversion": "npm run build",
    "postversion": "git push --follow-tags",
    "lint-tsc": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "spell": "cspell --show-context \"**/*.md\"",
    "prepare": "npm run build:prepare",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.mjs\" vite.config.ts eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.mjs\" vite.config.ts eslint.config.mjs",
    "test": "npm run build:prepare && node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^22.20.5",
    "cspell": "^10.4.0",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.14.0",
    "path-exists-cli": "^2.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-svgo": "^3.0.2"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "assets",
    "svg",
    "icons",
    "ubisoft",
    "rainbow",
    "six",
    "siege",
    "rainbowsixsiege",
    "rainbow6",
    "rainbow6siege",
    "r6s"
  ]
}
